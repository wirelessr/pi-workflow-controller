{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/code-change/skills.v1.json",
  "description": "Controller record of the private skill subtree expanded for this run. The Controller copied and digested the bytes and read nothing in them",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "files"
  ],
  "properties": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the \"<sha256>  <path>\\n\" lines of files, in files order (paths in byte order)"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "description": "Slash-separated and relative to the expansion directory",
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
