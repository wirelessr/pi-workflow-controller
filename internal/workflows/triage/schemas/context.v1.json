{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/context.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake",
    "wiki",
    "scope",
    "problem",
    "identity",
    "time",
    "observations",
    "attempts",
    "attachment_complete",
    "wiki_status",
    "gaps",
    "readiness"
  ],
  "properties": {
    "previous": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "resolved_gaps": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
      }
    },
    "intake": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "wiki": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "scope": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/scope"
    },
    "problem": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup",
        "status",
        "stack",
        "pop",
        "binding",
        "tenant_id",
        "orgkey",
        "userkey",
        "release"
      ],
      "properties": {
        "lookup": {
          "anyOf": [
            {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "resolved",
            "conflicting",
            "unresolved"
          ]
        },
        "stack": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        },
        "pop": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        },
        "binding": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        },
        "tenant_id": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        },
        "orgkey": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        },
        "userkey": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        },
        "release": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "from",
        "to",
        "anchors"
      ],
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "conflicting",
            "unresolved"
          ]
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/anchor"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source",
          "outcome",
          "evidence"
        ],
        "properties": {
          "queries": {
            "type": "array",
            "items": {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/supporting_query"
            }
          },
          "kind": {
            "enum": [
              "identity",
              "time"
            ]
          },
          "source": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"
            }
          }
        }
      }
    },
    "attachment_complete": {
      "type": "boolean"
    },
    "wiki_status": {
      "enum": [
        "completed-with-matches",
        "completed-no-matches",
        "partial",
        "unavailable",
        "not-run"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readiness": {
      "enum": [
        "ready",
        "needs-resolution"
      ]
    }
  }
}
