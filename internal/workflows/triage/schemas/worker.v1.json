{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/worker.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal", "context", "task_id", "work", "status", "inputs", "evidence", "queries", "analysis", "gaps", "next"],
  "properties": {
    "proposal": {"$ref": "common.v1.json#/$defs/ref"},
    "context": {"$ref": "common.v1.json#/$defs/ref"},
    "task_id": {"type": "string", "minLength": 1},
    "work": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "incomplete"]},
    "inputs": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/ref"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/evidence"}},
    "queries": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/supporting_query"}},
    "analysis": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/fact"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "next": {"type": "array", "items": {"$ref": "planner.v1.json#/properties/pending/items"}}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_kind", "responsibility", "question", "requirements", "basis", "depends_on", "search"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["code", "db", "logs", "metrics", "attachments", "vision"]},
        "responsibility": {"enum": ["evidence-only", "analysis"]},
        "question": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "basis": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/evidence"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "search": {"anyOf": [{"$ref": "#/$defs/search"}, {"type": "null"}]}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "filter", "from", "to", "basis"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "filter": { "type": "string", "minLength": 1 },
        "from": {
          "type": "string",
          "pattern": "Z$",
          "minLength": 1,
          "description": "UTC RFC 3339 timestamp ending in Z, strictly before to"
        },
        "to": {
          "type": "string",
          "pattern": "Z$",
          "minLength": 1,
          "description": "UTC RFC 3339 timestamp ending in Z, strictly later than from"
        },
        "basis": { "type": "array", "minItems": 1, "items": { "$ref": "common.v1.json#/$defs/evidence" } }
      }
    }
  }
}
