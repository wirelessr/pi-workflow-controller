{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/common.v1.json",
  "$defs": {
    "supporting_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "filter", "from", "to", "basis", "status", "outcome", "evidence"],
      "properties": {
        "source": { "type": "string" },
        "filter": { "type": "string" },
        "from": {
          "type": "string",
          "pattern": "Z$",
          "description": "UTC RFC 3339 timestamp ending in Z (e.g. 2026-10-01T10:41:34.603376Z), never a +00:00 numeric offset form"
        },
        "to": {
          "type": "string",
          "pattern": "Z$",
          "description": "UTC RFC 3339 timestamp ending in Z, strictly later than from"
        },
        "basis": {
          "type": "array",
          "items": {"$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"}
        },
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "outcome": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file_id",
        "reason"
      ],
      "properties": {
        "ref": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
        },
        "status": {
          "enum": [
            "available",
            "missing",
            "partial",
            "too-large",
            "unsafe",
            "unsupported"
          ]
        },
        "file_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_id",
        "path",
        "schema_id",
        "sha256",
        "manifest_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Full lowercase 64-hex-character sha256 of the referenced contract; copy byte-exact, never truncate"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Full lowercase 64-hex-character sha256 of the referenced manifest; copy byte-exact, never truncate"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "file_id"
      ],
      "properties": {
        "ref": {
          "anyOf": [
            {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_id": {
          "type": "string"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket",
        "stack",
        "pop",
        "binding",
        "tenant_ids"
      ],
      "properties": {
        "ticket": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        },
        "pop": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        },
        "tenant_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "original",
        "format",
        "source_tz",
        "utc",
        "offset_seconds",
        "evidence",
        "paired_epoch_millis",
        "paired_evidence"
      ],
      "properties": {
        "event": {
          "type": "string"
        },
        "original": {
          "type": "string",
          "description": "The raw timestamp exactly as observed in its source; shape depends on format (see allOf branches)"
        },
        "format": {
          "enum": [
            "rfc3339",
            "epoch-seconds",
            "epoch-millis",
            "local-paired"
          ]
        },
        "source_tz": {
          "type": "string"
        },
        "utc": {
          "type": "string",
          "pattern": "Z$",
          "description": "The anchor converted to UTC, an RFC 3339 string ending in Z; from/to must be byte-identical to the min/max of these"
        },
        "offset_seconds": {
          "type": "integer",
          "minimum": -86400,
          "maximum": 86400
        },
        "evidence": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"
        },
        "paired_epoch_millis": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "paired_evidence": {
          "anyOf": [
            {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "format": { "const": "rfc3339" } },
            "required": ["format"]
          },
          "then": {
            "properties": {
              "original": {
                "pattern": "(Z|[+-]\\d\\d:\\d\\d)$",
                "description": "Complete RFC 3339 timestamp with an explicit zone or numeric offset suffix (e.g. 2026-10-01T05:21:20.298Z), never a time-only fragment or a zone-less date-time. An absolute timestamp in another syntax (e.g. '2026-10-01 05:21:58 UTC') is still rfc3339: normalize original to RFC 3339 syntax (2026-10-01T05:21:58Z) instead of switching format to local-paired; local-paired is only for zone-less local timestamps"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "format": { "const": "epoch-seconds" } },
            "required": ["format"]
          },
          "then": {
            "properties": {
              "original": {
                "pattern": "^\\d+$",
                "description": "Bare integer epoch-seconds value, digits only, never the full surrounding string"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "format": { "const": "epoch-millis" } },
            "required": ["format"]
          },
          "then": {
            "properties": {
              "original": {
                "pattern": "^\\d+$",
                "description": "Bare integer epoch-millis value, digits only, never the full surrounding string"
              }
            }
          }
        }
      ]
    }
  }
}
