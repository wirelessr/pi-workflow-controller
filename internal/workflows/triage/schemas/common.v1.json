{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/common.v1.json",
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_id",
        "path",
        "schema_id",
        "sha256",
        "manifest_sha256"
      ],
      "description": "Exact committed Ref of an input, copied from the request",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the referenced contract"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the referenced manifest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "file_id"
      ],
      "description": "A cited kind=evidence file, optionally narrowed by a locator. ref null cites this contract's own files[]; otherwise ref is one of the Step's citable inputs and file_id is that input's files[] id",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_id": {
          "type": "string",
          "minLength": 1,
          "description": "The cited file's files[] id"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where in the file: a JSON pointer (RFC 6901) into a JSON file, or offset and length in bytes for any file",
          "properties": {
            "pointer": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "length": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "pointer"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "offset"
                    ]
                  },
                  {
                    "required": [
                      "length"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "offset",
                "length"
              ],
              "not": {
                "required": [
                  "pointer"
                ]
              }
            }
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128,
      "description": "Item id: letters, digits, dot, underscore or hyphen, unique within its contract"
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "description": "Work that remains undone or failed; a genuine absence confirmed from evidence is not a gap",
      "properties": {
        "id": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/id"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "original",
        "format",
        "source_tz",
        "utc",
        "offset_seconds",
        "evidence",
        "paired_epoch_millis",
        "paired_evidence"
      ],
      "properties": {
        "id": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/id"
        },
        "event": {
          "type": "string",
          "pattern": "\\S",
          "description": "The incident event this timestamp belongs to"
        },
        "original": {
          "type": "string",
          "description": "The raw timestamp exactly as observed in its source; shape depends on format (see allOf branches)"
        },
        "format": {
          "enum": [
            "rfc3339",
            "epoch-seconds",
            "epoch-millis",
            "local-paired"
          ]
        },
        "source_tz": {
          "type": "string",
          "pattern": "\\S",
          "description": "Zone name of the source timestamp"
        },
        "utc": {
          "type": "string",
          "pattern": "Z$",
          "description": "The same instant as original in UTC, at original's precision, ending in Z"
        },
        "offset_seconds": {
          "type": "integer",
          "minimum": -86400,
          "maximum": 86400
        },
        "evidence": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/located_evidence"
        },
        "paired_epoch_millis": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "paired_evidence": {
          "anyOf": [
            {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/located_evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "rfc3339"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "original": {
                "pattern": "(Z|[+-]\\d\\d:\\d\\d)$",
                "description": "RFC 3339 timestamp with an explicit zone or offset; an absolute time written in another syntax is normalized to RFC 3339 here"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "epoch-seconds"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "original": {
                "pattern": "^\\d+$",
                "description": "Epoch seconds"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "epoch-millis"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "original": {
                "pattern": "^\\d+$",
                "description": "Epoch milliseconds"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "local-paired"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "original": {
                "description": "Zone-less local date-time of an event whose absolute time is paired in paired_epoch_millis"
              },
              "paired_epoch_millis": {
                "type": "integer",
                "description": "The same event's absolute epoch millis"
              },
              "paired_evidence": {
                "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/located_evidence",
                "description": "Evidence of the paired absolute timestamp"
              }
            }
          }
        }
      ],
      "description": "One observed incident timestamp with its UTC conversion; the Controller recomputes utc and offset_seconds from original"
    },
    "located_evidence": {
      "allOf": [
        {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence"
        },
        {
          "required": [
            "locator"
          ]
        }
      ],
      "description": "Evidence with the place read: pointer \"\" cites a whole JSON document, offset 0 with the file size a whole other file"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "value",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "tenant_id",
            "orgkey",
            "ui_hostname",
            "home_pop",
            "customer_name",
            "user",
            "other"
          ],
          "description": "What the value identifies"
        },
        "value": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/located_evidence"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "description": "A fact with the evidence that states it"
    },
    "vision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attachment",
        "question"
      ],
      "properties": {
        "id": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/id"
        },
        "attachment": {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/evidence",
          "description": "The image file: an intake attachment, or one this contract fetched itself (ref null)"
        },
        "question": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
