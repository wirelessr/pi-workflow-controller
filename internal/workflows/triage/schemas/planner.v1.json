{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/planner.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "previous", "hypotheses", "pending", "gaps", "rationale"],
  "allOf": [
    {"if": {"required": ["ledger"]}, "then": {"required": ["worker_tasks", "worker_results", "wiki_results"]}},
    {"if": {"required": ["checkpoint"]}, "then": {"required": ["ledger"]}},
    {"if": {"required": ["recovery"]}, "then": {"required": ["ledger"]}}
  ],
  "properties": {
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "dispatch_cycle", "deliveries", "planner_failures"],
      "properties": {
        "dispatch_cycle": {"type": "integer", "minimum": 0},
        "policy": {"type": "object", "additionalProperties": false, "required": ["planner_retries"], "properties": {"planner_retries": {"type": "integer", "minimum": 0}}},
        "deliveries": {"type": "array", "items": {"$ref": "#/$defs/recoveryDelivery"}},
        "planner_failures": {"type": "array", "items": {"$ref": "#/$defs/recoveryFailure"}}
      }
    },
    "recovery_choices": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["delivery_id", "action", "reason", "basis"],
        "properties": {
          "delivery_id": {"type": "string", "minLength": 1},
          "action": {"enum": ["inspect", "resume", "redirect"]},
          "reason": {"type": "string", "minLength": 1},
          "basis": {"type": "array", "minItems": 1, "items": {"$ref": "common.v1.json#/$defs/evidence"}}
        }
      }
    },
    "checkpoint": {
      "description": "Copy the supplied Controller metadata exactly. Retain policy and the entire controller_feedback prefix. dispatch_cycle counts one completed worker batch, supporting task or wiki delivery received by this full Planner snapshot, not ledger.round, planning or session changes. checkpoint_cycle is the latest multiple of three; full_checkpoint is true only on the delivery reaching that cycle. Go validates transitions, feedback refs and exact echo after the existing state checks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "dispatch_cycle", "checkpoint_cycle", "full_checkpoint", "adaptive_note", "controller_feedback"],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handoff_percent"],
          "properties": {
            "handoff_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
          }
        },
        "dispatch_cycle": {"type": "integer", "minimum": 0},
        "checkpoint_cycle": {"type": "integer", "minimum": 0, "multipleOf": 3},
        "full_checkpoint": {"type": "boolean"},
        "adaptive_note": {"type": "string"},
        "controller_feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "note"],
            "properties": {
              "after": {"$ref": "common.v1.json#/$defs/ref"},
              "note": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "wiki_results": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.v1.json#/$defs/ref"}},
    "wiki_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terms", "previous_terms", "reason", "basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "previous_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1},
        "basis": {"type": "array", "minItems": 1, "items": {"$ref": "common.v1.json#/$defs/evidence"}}
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason", "round", "no_progress", "reframe_round", "reframe_streak", "consumed_batch", "changes", "reframe"],
      "properties": {
        "action": {"enum": ["workers", "support", "wiki", "reframe", "plan", "yield"]},
        "reason": {"type": "string", "minLength": 1},
        "round": {"type": "integer", "minimum": 0},
        "no_progress": {"type": "integer", "minimum": 0},
        "reframe_round": {"type": "integer", "minimum": 0},
        "reframe_streak": {"type": "integer", "minimum": 0},
        "consumed_batch": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "common.v1.json#/$defs/ref"}},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hypothesis_id", "change", "reason", "basis"],
            "properties": {
              "hypothesis_id": {"type": "string", "minLength": 1},
              "change": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "basis": {"type": "array", "minItems": 1, "items": {"$ref": "common.v1.json#/$defs/evidence"}}
            }
          }
        },
        "reframe": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["change", "reason", "basis"],
              "properties": {
                "change": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1},
                "basis": {"type": "array", "minItems": 1, "items": {"$ref": "common.v1.json#/$defs/evidence"}}
              }
            }
          ]
        }
      }
    },
    "worker_tasks": {"type": "array", "items": {"$ref": "worker.v1.json#/$defs/task"}},
    "worker_results": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.v1.json#/$defs/ref"}},
    "supporting_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "basis", "sources"],
      "properties": {
        "kind": {"enum": ["resolve", "refresh", "update"]},
        "reason": {"type": "string"},
        "basis": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/evidence"}},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "reason"],
            "properties": {
              "source": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "context": {"$ref": "common.v1.json#/$defs/ref"},
    "previous": {
      "anyOf": [{"$ref": "common.v1.json#/$defs/ref"}, {"type": "null"}]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "assessment", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "assessment": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/evidence"}}
        }
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "requirements", "basis"],
        "properties": {
          "question": {"type": "string"},
          "requirements": {"type": "array", "items": {"type": "string"}},
          "basis": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/evidence"}}
        }
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"}
  },
  "$defs": {
    "recoveryFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "code", "origin", "dispatch", "run_id", "step_id", "attempt_id", "identity", "diagnostic"],
      "properties": {
        "stage": {"type": "string"}, "task_id": {"type": "string"}, "code": {"enum": ["TimedOut", "CompactionFailed", "Cancelled"]},
        "origin": {"enum": ["AttemptDeadline", "Compaction", "FailFastSibling"]},
        "dispatch": {"enum": ["yes", "no", "unknown"]},
        "run_id": {"type": "string"}, "step_id": {"type": "string"}, "attempt_id": {"type": "string"},
        "identity": {"type": "object"}, "execution": {"type": "object"}, "cleanup": {"type": "object"},
        "diagnostic": {"type": "string", "minLength": 1}
      }
    },
    "recoveryDelivery": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "proposal", "context", "results", "failures"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["workers", "support", "wiki"]},
        "proposal": {"$ref": "common.v1.json#/$defs/ref"}, "context": {"$ref": "common.v1.json#/$defs/ref"},
        "results": {"type": "array", "items": {"$ref": "common.v1.json#/$defs/ref"}},
        "failures": {"type": "array", "items": {"$ref": "#/$defs/recoveryFailure"}},
        "support": {
          "type": "object", "additionalProperties": false,
          "required": ["proposal", "context", "work", "failed_phase"],
          "properties": {
            "proposal": {"$ref": "common.v1.json#/$defs/ref"}, "context": {"$ref": "common.v1.json#/$defs/ref"},
            "work": {"$ref": "#/properties/supporting_work"},
            "intake": {"$ref": "common.v1.json#/$defs/ref"}, "wiki": {"$ref": "common.v1.json#/$defs/ref"},
            "authorization": {"$ref": "common.v1.json#/$defs/ref"}, "failed_phase": {"type": "string"}
          }
        }
      }
    }
  }
}
