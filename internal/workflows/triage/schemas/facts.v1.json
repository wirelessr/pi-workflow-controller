{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/facts.v1.json",
  "description": "Candidate facts from text sources, each citing where it was read",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake",
    "prompt",
    "facts",
    "time_anchors",
    "vision_requests",
    "gaps"
  ],
  "properties": {
    "intake": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref",
      "description": "The intake input"
    },
    "prompt": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref",
      "description": "The caller prompt input"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/fact"
      }
    },
    "time_anchors": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/anchor"
      }
    },
    "vision_requests": {
      "type": "array",
      "description": "Image attachments whose content is needed, each with the question to answer from it",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/vision_request"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/gap"
      }
    }
  }
}
