{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/intake.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket",
    "url",
    "fetched_at",
    "issue",
    "fields",
    "comments",
    "linked",
    "attachments",
    "complete",
    "gaps"
  ],
  "properties": {
    "previous": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "acquisition": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
    },
    "ticket": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string"
    },
    "issue": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
    },
    "fields": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "source"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
          }
        }
      }
    },
    "linked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "source"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "source": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content",
          "analysis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
          },
          "analysis": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
