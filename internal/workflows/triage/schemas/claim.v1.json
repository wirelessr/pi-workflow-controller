{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/claim.v1.json",
  "description": "The Controller's claim for verification: a round's candidate with its own evidence cited through the round's Ref",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round",
    "steward",
    "candidate"
  ],
  "properties": {
    "round": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "steward": {
      "anyOf": [
        {
          "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ],
      "description": "The T2a pass; null when the challenge limit skipped T2a"
    },
    "candidate": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/round.v1.json#/properties/candidate/anyOf/1"
    }
  }
}
