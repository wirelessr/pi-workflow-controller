{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/wiki.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake",
    "queries",
    "scope",
    "status",
    "pages",
    "search",
    "gaps"
  ],
  "properties": {
    "intake": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "enum": [
        "wiki-only"
      ]
    },
    "status": {
      "enum": [
        "completed-with-matches",
        "completed-no-matches",
        "partial",
        "unavailable",
        "not-run"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
      }
    },
    "search": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/source"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
