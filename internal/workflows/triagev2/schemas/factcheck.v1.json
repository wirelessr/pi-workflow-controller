{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/factcheck.v1.json",
  "description": "Independent judgment of each fact and time anchor of the subject facts contract against the evidence it cites",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "items",
    "warnings",
    "gaps"
  ],
  "properties": {
    "subject": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref",
      "description": "The facts contract under review, copied byte-exact from the request"
    },
    "items": {
      "type": "array",
      "description": "Exactly one verdict per item id the request lists in judge",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "reason",
          "basis"
        ],
        "properties": {
          "id": {
            "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/id"
          },
          "verdict": {
            "enum": [
              "supported",
              "unsupported",
              "insufficient"
            ],
            "description": "supported: the text at the cited place states it; unsupported: it does not, or the only basis is a name or hostname; insufficient: the evidence given cannot decide it"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/located_evidence"
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/gap"
      }
    },
    "warnings": {
      "type": "array",
      "description": "Disagreements to report without demoting either side, such as the caller prompt versus the ticket",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "basis"
        ],
        "properties": {
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/located_evidence"
            }
          }
        }
      }
    }
  }
}
