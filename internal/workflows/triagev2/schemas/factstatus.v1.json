{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflow-controller.local/schemas/triage/factstatus.v1.json",
  "description": "Controller record that binds the final facts and their check; each item the check did not judge supported is treated as absent and has a gap here",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facts",
    "check",
    "gaps"
  ],
  "properties": {
    "facts": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "check": {
      "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/ref"
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "https://pi-workflow-controller.local/schemas/triage/common.v1.json#/$defs/gap"
      }
    }
  }
}
